# Copy to .env.local (`cp .env.example .env.local`) and fill in real values.
# Only VITE_-prefixed variables are exposed to the browser bundle.

# Supabase project (Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Monnify public checkout credentials (public by design; the secret key never goes here)
VITE_MONNIFY_API_KEY=MK_TEST_XXXXXXXXXX
VITE_MONNIFY_CONTRACT_CODE=0000000000

# --- Supabase Edge Function secrets (NOT read by Vite) ---
# Set with: supabase secrets set MONNIFY_API_KEY=... MONNIFY_SECRET_KEY=...
# MONNIFY_API_KEY, MONNIFY_SECRET_KEY, MONNIFY_BASE_URL (default https://api.monnify.com)
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically by Supabase.
